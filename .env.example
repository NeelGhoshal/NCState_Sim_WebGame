# Copy to .env.local and fill in ONE provider. .env.local is git-ignored.
# Read by the Python AI service (ai/app/config.py). Restart npm run dev after changes.
# With nothing set, the game runs in scripted mode (no model calls).

# --- Groq (free tier, recommended): https://console.groq.com/keys
GROQ_API_KEY=
# --- OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. One of: groq | openrouter | ollama. Default: whichever key is set.
LLM_PROVIDER=

# Optional model overrides. "small" = dialogue, "large" = reflection and director.
# LLM_MODEL_SMALL=openai/gpt-oss-20b
# LLM_MODEL_LARGE=openai/gpt-oss-120b

# Local Ollama (development only): set LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL_SMALL=qwen3:8b
# LLM_MODEL_LARGE=qwen3:8b

# --- Campus knowledge (RAG). See ai/app/rag/.
# How often the AI service collects NC State events and news, in hours. 0 turns it off.
# RAG_REFRESH_HOURS=6
# Contact details for the User-Agent, required by Wikipedia's robot policy before
# `npm run rag:static` will collect Wikipedia background cards. An email or a project URL.
# RAG_CONTACT=
