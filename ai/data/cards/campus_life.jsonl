// Hand-written campus-life cards. Written for this game, in plain words; check facts before adding.
{"id": "life:wolfpack", "kind": "fact", "title": "The Wolfpack", "text": "NC State's teams are the Wolfpack, in red and white. Fans shout \"Go Pack!\" and one side of a crowd yells \"Wolf!\" while the other answers \"Pack!\". The Wolfpack hand sign is a wolf head made with your fingers.", "source": "Campus Life Sim", "topics": ["general", "athletics"]}
{"id": "life:rival", "kind": "fact", "title": "Rivals", "text": "NC State plays in the ACC. UNC-Chapel Hill is the big rival; students just call them Carolina, usually with a groan. Duke and Wake Forest are the other nearby ACC schools.", "source": "Campus Life Sim", "topics": ["general", "athletics"]}
{"id": "life:belltower", "kind": "fact", "title": "Memorial Belltower", "text": "The Memorial Belltower stands at the corner of Hillsborough Street and Pullen Road. It is lit red after Wolfpack wins and on special occasions, so a red Belltower at night means good news.", "source": "Campus Life Sim", "places": ["Memorial Belltower"], "topics": ["general"]}
{"id": "life:tunnel", "kind": "fact", "title": "Free Expression Tunnel", "text": "The Free Expression Tunnel runs under the railroad tracks between North Campus and Central Campus. Anyone can paint it, so the walls are layers of club ads, birthday messages and murals that change overnight.", "source": "Campus Life Sim", "places": ["Free Expression Tunnel"], "topics": ["general", "arts", "clubs"]}
{"id": "life:brickyard", "kind": "fact", "title": "The Brickyard", "text": "The Brickyard is the big brick plaza on North Campus. At class change it fills up; clubs table there, and it is where you run into people between classes.", "source": "Campus Life Sim", "places": ["The Brickyard"], "topics": ["general", "clubs"]}
{"id": "life:talley", "kind": "fact", "title": "Talley Student Union", "text": "Talley Student Union is the student union on Central Campus: food court, Wolfpack Outfitters, study lounges, ballrooms and Stewart Theatre. Most people just say Talley.", "source": "Campus Life Sim", "places": ["Talley Student Union"], "topics": ["general", "dining", "clubs"]}
{"id": "life:howlingcow", "kind": "fact", "title": "Howling Cow", "text": "Howling Cow ice cream is made with milk from NC State's own dairy cows. You can get it on campus, including in Talley, and it is a point of pride.", "source": "Campus Life Sim", "places": ["Talley Student Union"], "topics": ["general", "dining", "biology"]}
{"id": "life:wolfline", "kind": "fact", "title": "Wolfline", "text": "The Wolfline is NC State's free bus system. It links Main Campus with Centennial Campus and nearby housing; students check the app to see when the next bus is coming.", "source": "Campus Life Sim", "topics": ["general"]}
{"id": "life:dhhill", "kind": "fact", "title": "D.H. Hill Library", "text": "D.H. Hill Jr. Library sits beside the Brickyard on North Campus. It is the main library on Main Campus and gets packed around midterms and finals.", "source": "Campus Life Sim", "places": ["D.H. Hill Jr. Library"], "topics": ["general", "academics"]}
{"id": "life:hunt", "kind": "fact", "title": "Hunt Library", "text": "Hunt Library is on Centennial Campus. It is known for its futuristic design and the bookBot, a robot that fetches books from storage. Engineering students study there a lot.", "source": "Campus Life Sim", "places": ["Hunt Library"], "topics": ["general", "engineering", "technology", "academics"]}
{"id": "life:centennial", "kind": "fact", "title": "Centennial Campus", "text": "Centennial Campus is south of Main Campus: engineering buildings, research labs, company partners, Hunt Library and Lake Raleigh. The Wolfline gets you there.", "source": "Campus Life Sim", "topics": ["general", "engineering", "research"]}
{"id": "life:kkc", "kind": "fact", "title": "Krispy Kreme Challenge", "text": "The Krispy Kreme Challenge is a student-run race every February: run from the Belltower to the Krispy Kreme downtown, eat a dozen doughnuts, run back. It raises money for a children's hospital.", "source": "Campus Life Sim", "places": ["Memorial Belltower"], "topics": ["general", "wellness", "service"]}
{"id": "life:packapalooza", "kind": "fact", "title": "Packapalooza", "text": "Packapalooza is the big street festival on Hillsborough Street at the start of the fall semester, with music, food and student groups.", "source": "Campus Life Sim", "places": ["Hillsborough Street"], "topics": ["general", "arts", "clubs"]}
{"id": "life:welcome", "kind": "fact", "title": "Wolfpack Welcome Week", "text": "Wolfpack Welcome Week opens the fall semester with events every day for new and returning students: free food, club fairs and late-night activities.", "source": "Campus Life Sim", "topics": ["general", "clubs", "residence"]}
{"id": "life:football", "kind": "fact", "title": "Game days", "text": "Football plays at Carter-Finley Stadium, near the State Fairgrounds, a bus ride from Main Campus. Tailgating in the lots before kickoff is a big part of game day.", "source": "Campus Life Sim", "topics": ["general", "athletics"]}
{"id": "life:basketball", "kind": "fact", "title": "Basketball", "text": "Men's basketball plays at the Lenovo Center in Raleigh. Reynolds Coliseum on campus is the historic home of Wolfpack basketball and still hosts women's basketball and other events.", "source": "Campus Life Sim", "places": ["Reynolds Coliseum"], "topics": ["general", "athletics"]}
{"id": "life:mascots", "kind": "fact", "title": "Mascots", "text": "Mr. and Ms. Wuf are the costumed wolf mascots at games. There is also a live mascot, a Tamaskan dog named Tuffy.", "source": "Campus Life Sim", "topics": ["general", "athletics"]}
{"id": "life:hillsborough", "kind": "fact", "title": "Hillsborough Street", "text": "Hillsborough Street runs along the north edge of campus. It is lined with cheap food, coffee shops and late-night spots, and it is where students go when they are sick of the dining halls.", "source": "Campus Life Sim", "places": ["Hillsborough Street"], "topics": ["general", "dining"]}
{"id": "life:dining", "kind": "fact", "title": "Dining halls", "text": "The all-you-care-to-eat dining halls take meal swipes: Fountain on West Campus, Clark on East Campus near the Quad, and Case on Central Campus. Talley's food court takes dining dollars or cards.", "source": "Campus Life Sim", "places": ["Fountain Dining Hall", "Clark Dining Hall", "Case Dining Hall"], "topics": ["general", "dining", "residence"]}
{"id": "life:quad", "kind": "fact", "title": "The Quad", "text": "The Quad is a group of residence halls on East Campus around a lawn, including Bagwell, Becton, Berry, Gold, Welch and Syme. Clark Dining Hall is next to it.", "source": "Campus Life Sim", "places": ["The Quad"], "topics": ["general", "residence"]}
{"id": "life:tritowers", "kind": "fact", "title": "Tri-Towers", "text": "Bowen, Metcalf and Carroll Halls are the Tri-Towers on Central Campus, with Owen and Tucker Halls next door. They are first-year favorites because Talley and Carmichael are a short walk away.", "source": "Campus Life Sim", "places": ["Tucker Hall", "Owen Hall"], "topics": ["general", "residence"]}
{"id": "life:westcampus", "kind": "fact", "title": "West Campus", "text": "West Campus has Lee, Sullivan and Bragaw residence halls, Fountain Dining Hall and the Dan Allen parking deck. It is a hike to North Campus classes, so people leave early.", "source": "Campus Life Sim", "places": ["Lee Hall", "Sullivan Hall", "Bragaw Hall"], "topics": ["general", "residence"]}
{"id": "life:rec", "kind": "fact", "title": "Working out", "text": "Carmichael Gymnasium and the Wellness and Recreation Center are where people lift, swim and play intramurals. The intramural fields are next to them, south of Cates Avenue.", "source": "Campus Life Sim", "places": ["Carmichael Gymnasium"], "topics": ["general", "wellness", "athletics"]}
{"id": "life:court", "kind": "fact", "title": "Court of North Carolina", "text": "The Court of North Carolina is the lawn on North Campus framed by some of the oldest buildings, like Holladay Hall and the 1911 Building. On a nice day people sit out and study there.", "source": "Campus Life Sim", "places": ["Court of North Carolina"], "topics": ["general"]}
{"id": "life:media", "kind": "fact", "title": "Student media", "text": "Technician is the student newspaper, and WKNC 88.1 FM is the student radio station, known for indie and local music.", "source": "Campus Life Sim", "topics": ["general", "arts", "clubs"]}
{"id": "life:shortnames", "kind": "fact", "title": "What people call things", "text": "Students shorten everything: Talley for the student union, D.H. for D.H. Hill Library, Hunt for Hunt Library, Carmichael for the gym, Hillsborough for Hillsborough Street and Centennial for the south campus.", "source": "Campus Life Sim", "topics": ["general"]}
{"id": "life:classchange", "kind": "fact", "title": "Class change", "text": "Classes run in 50- and 75-minute blocks, and the ten minutes between them are a rush across the tracks through the tunnels. Being late from West Campus to North Campus is a rite of passage.", "source": "Campus Life Sim", "topics": ["general", "academics"]}
{"id": "life:chem", "kind": "fact", "title": "CH 101", "text": "CH 101 is the general chemistry course nearly every science and engineering first-year takes. It has a reputation as a weed-out class, so study groups form fast before the first exam.", "source": "Campus Life Sim", "topics": ["science", "premed", "health", "engineering", "biology", "academics"]}
{"id": "life:research", "kind": "fact", "title": "Getting into a lab", "text": "First-years get into research by emailing professors whose work interests them, going to office hours, and checking the undergraduate research office. Asking early in the semester helps.", "source": "Campus Life Sim", "topics": ["research", "biology", "science", "premed"]}
{"id": "life:clubs", "kind": "fact", "title": "Clubs", "text": "NC State has hundreds of student organizations. Most recruit at involvement fairs and by tabling in the Brickyard, and many meet in Talley in the evenings.", "source": "Campus Life Sim", "places": ["The Brickyard", "Talley Student Union"], "topics": ["general", "clubs"]}
{"id": "life:makers", "kind": "fact", "title": "Making things", "text": "Engineering students build in makerspaces with 3D printers and laser cutters, and Hunt Library on Centennial has a makerspace open to students. Hackathons fill a whole weekend.", "source": "Campus Life Sim", "places": ["Hunt Library"], "topics": ["engineering", "makers", "technology"]}
{"id": "life:premed", "kind": "fact", "title": "Pre-health", "text": "Pre-med students worry about GPA, shadowing hours and the MCAT. Many volunteer, join pre-health clubs and keep a spreadsheet of everything.", "source": "Campus Life Sim", "topics": ["premed", "health"]}
{"id": "life:coffee", "kind": "fact", "title": "Coffee", "text": "Talley has more than one coffee counter, and the morning line before 9 AM classes is long. Regulars learn which counter moves fastest.", "source": "Campus Life Sim", "places": ["Talley Student Union"], "topics": ["dining"]}
{"id": "life:arboretum", "kind": "fact", "title": "Gardens", "text": "The J.C. Raulston Arboretum, a short drive west of campus, is a free public garden run by NC State. Plant and biology students go there for class and for fun.", "source": "Campus Life Sim", "topics": ["biology", "wellness"]}
